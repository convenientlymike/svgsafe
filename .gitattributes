# Normalize line endings so Windows checkouts don't churn the diff.
* text=auto eol=lf

# Scripts that must keep platform-native endings
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf

# Binary assets — never normalize or diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary